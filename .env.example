# Copy to .env. Compose reads it automatically.

# Target system database (the subject under observation)
TARGET_DB_USER=orders
TARGET_DB_PASSWORD=change-me
TARGET_DB_NAME=orders

# Agent database — a separate instance
AGENT_DB_USER=incidentlens
AGENT_DB_PASSWORD=change-me
AGENT_DB_NAME=incidentlens

# LLM — set ONE key, or use Bedrock (no key: the EC2 instance role authorises it).
# LLM_PROVIDER: anthropic | openai | gemini | bedrock. Empty → the provider
# whose key is set. Bedrock must be chosen explicitly.
LLM_PROVIDER=bedrock
BEDROCK_REGION=eu-north-1
BEDROCK_MODEL=deepseek.v3.2
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Scenario tuning (defaults shown)
# DB_POOL_SIZE=5
# DB_HOLD_MS=100
# LOADGEN_GET_RATE=45
# LOADGEN_BURST_RATE=60
