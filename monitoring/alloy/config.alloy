// Ingestion path: Alloy discovers containers through the Docker socket, tails
// their stdout/stderr, and pushes to Loki. Loki never pulls.

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "target_system" {
  targets = []

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  // Only the subject under observation. The agent's own logs stay out of the
  // evidence it reasons over.
  rule {
    source_labels = ["service"]
    regex         = "orders-api|inventory-service|target-postgres|redis"
    action        = "keep"
  }
}

loki.source.docker "target_system" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.containers.targets
  relabel_rules = discovery.relabel.target_system.rules
  forward_to    = [loki.process.json_level.receiver]
}

// Promote the JSON "level" field to a label: low cardinality, and it lets the
// collector select warnings/errors without parsing every line.
loki.process "json_level" {
  stage.json {
    expressions = { level = "level" }
  }

  stage.labels {
    values = { level = "" }
  }

  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
